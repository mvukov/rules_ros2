{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
  ],
  dependencyDashboard: true,
  bazel: {
    ignorePaths: [
      'repositories/ros2_repositories_impl.bzl',
    ],
  },
  'bazel-module': {
    ignorePaths: [],
  },
  pip_requirements: {
    enabled: false,
  },
  'pre-commit': {
    enabled: true,
  },
  packageRules: [
    {
      matchManagers: [
        'bazel',
      ],
      enabled: false,
      matchPackageNames: [
        '*',
      ],
    },
    {
      matchManagers: [
        'bazel',
      ],
      matchDepNames: [
        'foxglove_bridge',
        'ros2_rust',
        'ros2_rosidl_runtime_rs',
        'ros2_rosidl_rust',
      ],
      enabled: true,
    },
    {
      matchManagers: [
        'pre-commit',
      ],
      groupName: 'pre-commit-deps',
      matchPackageNames: [
        '*',
      ],
    },
  ],
  schedule: [
    'every 1 months on the first day of the month',
  ],
}
