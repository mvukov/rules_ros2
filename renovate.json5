{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["config:recommended"],
  dependencyDashboard: true,
  bazel: {
    ignorePaths: ["repositories/ros2_repositories_impl.bzl"],
  },
  // config:recommended ignores **/examples/** by default, and we want examples/MODULE.bazel to be updated.
  "bazel-module": {
    ignorePaths: [],
  },
  pip_requirements: {
    enabled: false,
  },
  "pre-commit": {
    enabled: true,
  },
  packageRules: [
    {
      matchManagers: ["bazel"],
      matchPackageNames: ["*"],
      enabled: false,
    },
    {
      matchManagers: ["bazel"],
      matchDepNames: [
        "foxglove_bridge",
        "ros2_rust",
        "ros2_rosidl_runtime_rs",
        "ros2_rosidl_rust",
      ],
      enabled: true,
    },
    {
      matchManagers: ["pre-commit"],
      matchPackageNames: ["*"],
      groupName: "pre-commit-deps",
    },
  ],
  schedule: ["every 1 months on the first day of the month"],
}
