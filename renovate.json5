{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
  ],
  dependencyDashboard: {
    enabled: true,
  },
  bazel: {
    ignorePaths: [
      'repositories/ros2_repositories_impl.bzl',
    ],
  },
  'bazel-module': {
    ignorePaths: [],
  },
  pip_requirements: {
    enabled: false,
  },
  'pre-commit': {
    enabled: true,
  },
  packageRules: [
    {
      matchManagers: [
        'bazel',
      ],
      matchPackageNames: [
        '*',
      ],
      enabled: false,
    },
    {
      matchManagers: [
        'bazel',
      ],
      matchDepNames: [
        'foxglove_bridge',
      ],
      enabled: true,
      versioning: 'regex:^ros-v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$',
    },
    {
      matchManagers: [
        'bazel',
      ],
      matchDepNames: [
        'ros2_rust',
        'ros2_rosidl_runtime_rs',
        'ros2_rosidl_rust',
      ],
      enabled: true,
      groupName: 'ros2-rust-deps',
    },
    {
      matchManagers: [
        'bazel-module',
      ],
      matchDepNames: [
        'asio',
      ],
      allowedVersions: '<1.33',
    },
    {
      matchManagers: [
        'pre-commit',
      ],
      matchPackageNames: [
        '*',
      ],
      groupName: 'pre-commit-deps',
    },
  ],
  schedule: [
    'every 1 months on the first day of the month',
  ],
}
