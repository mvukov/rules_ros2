""" Builds rmw.
"""

load(
    "@com_github_mvukov_rules_ros2//ros2:cc_defs.bzl",
    "ros2_c_library",
    "ros2_cpp_library",
)

ros2_c_library(
    name = "rmw",
    srcs = glob(["rmw/src/*.c"]),
    hdrs = glob(["rmw/include/**/*.h"]),
    includes = ["rmw/include"],
    visibility = ["//visibility:public"],
    deps = [
        "@ros2_rcutils//:rcutils",
        "@ros2_rosidl//:rosidl_runtime_c",
        "@ros2_rosidl_dynamic_typesupport//:rosidl_dynamic_typesupport",
    ],
)

ros2_cpp_library(
    name = "rmw_cpp",
    hdrs = glob([
        "rmw/include/**/*.hpp",
        "rmw/include/**/*.h",
    ]),
    includes = ["rmw/include"],
    visibility = ["//visibility:public"],
    deps = [":rmw"],
)

ros2_cpp_library(
    name = "rmw_security_common",
    srcs = ["rmw_security_common/src/security.cpp"],
    hdrs = glob([
        "rmw_security_common/include/**/*.h",
        "rmw_security_common/include/**/*.hpp",
    ]),
    includes = ["rmw_security_common/include"],
    local_defines = ["RMW_SECURITY_COMMON_BUILDING_LIBRARY"],
    visibility = ["//visibility:public"],
    deps = [
        ":rmw",
        "@ros2_rcutils//:rcutils",
    ],
)
