""" Builds foxglove_bridge (from the foxglove-sdk repository).
"""

load("@com_github_mvukov_rules_ros2//ros2:cc_defs.bzl", "ros2_cpp_library")
load(
    "@com_github_mvukov_rules_ros2//third_party:expand_template.bzl",
    "expand_template",
)
load("@rules_cc//cc:defs.bzl", "cc_library")

alias(
    name = "foxglove_sdk",
    actual = select(
        {
            "@platforms//cpu:aarch64": "@foxglove_sdk_aarch64//:foxglove",
            "@platforms//cpu:x86_64": "@foxglove_sdk_x86_64//:foxglove",
        },
        no_match_error = "foxglove_bridge supports only x86_64 and aarch64 Linux",
    ),
)

expand_template(
    name = "version_hpp",
    out = "include/foxglove_bridge/version.hpp",
    substitutions = {
        "@FOXGLOVE_BRIDGE_VERSION@": "3.6.3",
        "@FOXGLOVE_BRIDGE_GIT_HASH@": "N/A",
    },
    template = "include/foxglove_bridge/version.hpp.in",
)

ros2_cpp_library(
    name = "foxglove_bridge_component",
    srcs = [
        "src/generic_client.cpp",
        "src/message_definition_cache.cpp",
        "src/param_utils.cpp",
        "src/parameter_interface.cpp",
        "src/ros2_foxglove_bridge.cpp",
    ],
    hdrs = glob(["include/foxglove_bridge/*.hpp"]) + [":version_hpp"],
    includes = ["include"],
    # NOTE: Keep in sync with the resource_retriever version.
    local_defines = [
        "RESOURCE_RETRIEVER_VERSION_MAJOR=3",
        "RESOURCE_RETRIEVER_VERSION_MINOR=9",
        "RESOURCE_RETRIEVER_VERSION_PATCH=3",
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":foxglove_sdk",
        "@ros2_ament_index//:ament_index_cpp",
        "@ros2_common_interfaces//:cpp_std_msgs",
        "@ros2_rcl_interfaces//:cpp_rcl_interfaces",
        "@ros2_rcl_interfaces//:cpp_rosgraph_msgs",
        "@ros2_rclcpp//:rclcpp",
        "@ros2_rclcpp//:rclcpp_components",
        "@ros2_rcpputils//:rcpputils",
        "@ros2_rcutils//:rcutils",
        "@ros2_resource_retriever//:resource_retriever",
        "@ros2_rosidl//:rosidl_typesupport_introspection_cpp",
        "@rosx_introspection",
    ],
)

# The WebSocket test client used by upstream tests.
cc_library(
    name = "test_client",
    hdrs = glob(["tests/client/*.hpp"]),
    includes = ["tests"],
    visibility = ["//visibility:public"],
    deps = [
        "@nlohmann_json//:json",
        "@websocketpp",
    ],
)

exports_files(
    ["tests/smoke_test.cpp"],
    visibility = ["//visibility:public"],
)
