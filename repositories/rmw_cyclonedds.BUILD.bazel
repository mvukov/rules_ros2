""" Builds rmw_cyclonedds.
"""

load("@com_github_mvukov_rules_ros2//ros2:cc_defs.bzl", "ros2_cpp_binary")
load(
    "@com_github_mvukov_rules_ros2//third_party:expand_template.bzl",
    "expand_template",
)

# NOTE: Keep in sync with the cyclonedds version.
# CDDS_VERSION == 1100 selects the Cyclone DDS >= 0.11 code paths
# (shared memory via the Iceoryx PSMX plugin, no iceoryx_binding_c needed).
expand_template(
    name = "cdds_version_hpp",
    out = "rmw_cyclonedds_cpp/src/cdds_version.hpp",
    substitutions = {
        "@CycloneDDS_VERSION_MAJOR@": "11",
        "@CycloneDDS_VERSION_MINOR@": "0",
    },
    template = "rmw_cyclonedds_cpp/src/cdds_version.hpp.in",
)

ros2_cpp_binary(
    name = "rmw_cyclonedds",
    srcs = glob([
        "rmw_cyclonedds_cpp/src/*.c",
        "rmw_cyclonedds_cpp/src/*.cpp",
        "rmw_cyclonedds_cpp/src/*.hpp",
    ]) + [":cdds_version_hpp"],
    copts = ["-fvisibility=hidden"],
    includes = ["rmw_cyclonedds_cpp/src"],
    linkopts = ["-fvisibility=hidden"],
    linkshared = True,
    visibility = ["//visibility:public"],
    deps = [
        "@cyclonedds",
        "@ros2_rcpputils//:rcpputils",
        "@ros2_rcutils//:rcutils",
        "@ros2_rmw//:rmw",
        "@ros2_rmw//:rmw_cpp",
        "@ros2_rmw//:rmw_security_common",
        "@ros2_rmw_dds_common//:rmw_dds_common_lib",
        "@ros2_rosidl//:rosidl_runtime_c",
        "@ros2_rosidl//:rosidl_typesupport_introspection_c",
        "@ros2_rosidl//:rosidl_typesupport_introspection_cpp",
        "@ros2_tracing//:tracetools",
    ],
)
