load("@com_github_mvukov_rules_ros2//ros2:cc_defs.bzl", "ros2_cpp_test")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_test")

cc_binary(
    name = "probe",
    testonly = True,
    srcs = ["probe.cc"],
    deps = ["//ros2/ros_domain_id"],
)

cc_test(
    name = "resolve_ros_domain_id_tests",
    size = "small",
    srcs = ["resolve_ros_domain_id_tests.cc"],
    data = [
        ":probe",
        "//ros2/ros_domain_id:resolve_ros_domain_id",
    ],
    env = {
        "PROBE": "$(rootpath :probe)",
        "RESOLVE_ROS_DOMAIN_ID": "$(rootpath //ros2/ros_domain_id:resolve_ros_domain_id)",
    },
    deps = [
        "//ros2/ros_domain_id",
        "@googletest//:gtest",
        "@googletest//:gtest_main",
    ],
)

ros2_cpp_test(
    name = "ros2_cpp_test_domain_id_tests",
    size = "small",
    srcs = ["ros2_cpp_test_domain_id_tests.cc"],
    set_up_ament = False,
    deps = [
        "//ros2/ros_domain_id",
        "@googletest//:gtest",
        "@googletest//:gtest_main",
    ],
)
