load("@com_github_mvukov_rules_ros2//ros2:cc_defs.bzl", "ros2_cpp_test")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_test")

cc_binary(
    name = "probe",
    testonly = True,
    srcs = ["probe.cc"],
    deps = ["//ros2/domain_coordinator"],
)

cc_test(
    name = "run_test_isolated_tests",
    size = "small",
    srcs = ["run_test_isolated_tests.cc"],
    data = [
        ":probe",
        "//ros2/domain_coordinator:run_test_isolated",
    ],
    env = {
        "PROBE": "$(rootpath :probe)",
        "RUN_TEST_ISOLATED": "$(rootpath //ros2/domain_coordinator:run_test_isolated)",
    },
    deps = [
        "//ros2/domain_coordinator",
        "@googletest//:gtest",
        "@googletest//:gtest_main",
    ],
)

ros2_cpp_test(
    name = "ros2_cpp_test_domain_id_tests",
    size = "small",
    srcs = ["ros2_cpp_test_domain_id_tests.cc"],
    set_up_ament = False,
    deps = [
        "//ros2/domain_coordinator",
        "@googletest//:gtest",
        "@googletest//:gtest_main",
    ],
)
