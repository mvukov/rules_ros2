load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("@com_github_mvukov_rules_ros2//ros2:ament.bzl", "ros2_ament_setup")
load("@com_github_mvukov_rules_ros2//ros2:cc_defs.bzl", "ros2_cpp_test")
load(
    "@com_github_mvukov_rules_ros2//ros2:interfaces.bzl",
    "cpp_ros2_interface_library",
    "py_ros2_interface_library",
    "ros2_interface_library",
)
load("@rules_python//python:defs.bzl", "py_test")
load("@rules_ros2_pip_deps//:requirements.bzl", "requirement")

ros2_interface_library(
    name = "test_messages",
    srcs = [
        "msg/Bar.idl",
        "msg/Baz.msg",
        "msg/Foo.msg",
    ],
)

py_ros2_interface_library(
    name = "py_test_messages",
    deps = [":test_messages"],
)

cpp_ros2_interface_library(
    name = "cpp_test_messages",
    deps = [":test_messages"],
)

ros2_cpp_test(
    name = "cpp_messages_tests",
    srcs = ["cpp_messages_tests.cc"],
    deps = [
        ":cpp_test_messages",
        "@googletest//:gtest_main",
        "@ros2_ament_index//:ament_index_cpp",
    ],
)

py_test(
    name = "py_messages_tests",
    srcs = ["py_messages_tests.py"],
    deps = [
        ":py_test_messages",
        requirement("pytest"),
    ],
)

# Regression coverage for a ros2_ament_setup crash when a ros2_interface_library
# is reachable through `deps` without any lang-bindings target (e.g. cpp_ros2_interface_library)
# in between, so no code generation ever runs for it.
ros2_ament_setup(
    name = "ament_setup_without_lang_bindings",
    testonly = True,
    tags = ["manual"],
    deps = [":test_messages"],
)

build_test(
    name = "ament_setup_without_lang_bindings_test",
    targets = [":ament_setup_without_lang_bindings"],
)
