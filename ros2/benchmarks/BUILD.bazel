load("@rules_python//python:defs.bzl", "py_binary")

# Benchmarks the overhead of ROS domain ID isolation: the C++
# //ros2/domain_coordinator:run_test_isolated vs. a Python equivalent built on
# upstream's domain_coordinator (as in ament_cmake_ros' run_test_isolated.py).
#
# Run with:
#   bazel run -c opt //ros2/benchmarks:run_test_isolated_benchmark
# See run_test_isolated_benchmark.py for options.

py_binary(
    name = "run_test_isolated_py",
    srcs = ["run_test_isolated_py.py"],
    deps = ["@ros2_ament_cmake_ros//:domain_coordinator"],
)

py_binary(
    name = "run_test_isolated_benchmark",
    srcs = ["run_test_isolated_benchmark.py"],
    args = [
        "--cc=$(rootpath //ros2/domain_coordinator:run_test_isolated)",
        "--py=$(rootpath :run_test_isolated_py)",
    ],
    data = [
        ":run_test_isolated_py",
        "//ros2/domain_coordinator:run_test_isolated",
    ],
)
