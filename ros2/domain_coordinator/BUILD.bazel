load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_test")

# Tests live next to the sources, except for tests that need ros2_cpp_test:
# those live in //ros2/test/domain_coordinator, since //ros2:cc_defs.bzl
# depends on :run_test_isolated.

cc_library(
    name = "domain_coordinator",
    srcs = ["domain_coordinator.cc"],
    hdrs = ["domain_coordinator.h"],
    visibility = ["//ros2:__subpackages__"],
)

cc_binary(
    name = "run_test_isolated",
    srcs = ["run_test_isolated.cc"],
    visibility = ["//visibility:public"],
    deps = [":domain_coordinator"],
)

cc_test(
    name = "domain_coordinator_tests",
    size = "small",
    srcs = ["domain_coordinator_tests.cc"],
    deps = [
        ":domain_coordinator",
        "@googletest//:gtest",
        "@googletest//:gtest_main",
    ],
)

cc_binary(
    name = "probe",
    testonly = True,
    srcs = ["probe.cc"],
    deps = [":domain_coordinator"],
)

cc_test(
    name = "run_test_isolated_tests",
    size = "small",
    srcs = ["run_test_isolated_tests.cc"],
    data = [
        ":probe",
        ":run_test_isolated",
    ],
    env = {
        "PROBE": "$(rootpath :probe)",
        "RUN_TEST_ISOLATED": "$(rootpath :run_test_isolated)",
    },
    deps = [
        ":domain_coordinator",
        "@googletest//:gtest",
        "@googletest//:gtest_main",
    ],
)
