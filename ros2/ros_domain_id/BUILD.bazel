load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_test")

cc_library(
    name = "ros_domain_id",
    srcs = ["ros_domain_id.cc"],
    hdrs = ["ros_domain_id.h"],
)

cc_binary(
    name = "resolve_ros_domain_id",
    srcs = ["resolve_ros_domain_id.cc"],
    visibility = ["//visibility:public"],
    deps = [":ros_domain_id"],
)

cc_test(
    name = "ros_domain_id_tests",
    size = "small",
    srcs = ["ros_domain_id_tests.cc"],
    deps = [
        ":ros_domain_id",
        "@googletest//:gtest",
        "@googletest//:gtest_main",
    ],
)
